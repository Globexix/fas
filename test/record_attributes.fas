use "C" "c_import/record_attributes.h"

extern "C" {
  fn main() i32 {
    if sizeof[FasPackedTrailing] != fas_packed_size() { return 1 }
    if alignof[FasPackedTrailing] != fas_packed_align() { return 2 }
    if offsetof[FasPackedTrailing, value] != fas_packed_value_offset() { return 3 }
    if sizeof[FasAlignedTrailing] != fas_aligned_size() { return 4 }
    if alignof[FasAlignedTrailing] != fas_aligned_align() { return 5 }
    if offsetof[FasAlignedTrailing, value] != fas_aligned_value_offset() { return 6 }
    if sizeof[FasAlignedTypedef] != fas_typedef_size() { return 7 }
    if alignof[FasAlignedTypedef] != fas_typedef_align() { return 8 }
    if offsetof[FasAlignedTypedef, bytes] != fas_typedef_bytes_offset() { return 9 }
    return 0
  }
}
