use "C" <<C
static unsigned oracle(unsigned lane, unsigned op) {
  unsigned x = lane + 1u;
  if (op == 0) return (x << 1) | (x >> 31);
  if (op == 1) return (x >> 1) | (x << 31);
  if (op == 2) return lane < 2 ? 0 : 4u - lane;
  if (op == 3) return (lane & 1) ? x : 9u;
  return ((unsigned long long)x * 0xffffffffu) >> 32;
}
C
const V vec[4,u32] = {1,2,3,4}
const L vec[4,u32] = rotl(V, 1)
const R vec[4,u32] = rotr(V, 1)
const S vec[4,u32] = shuffle(V, splat(0), {7,4,1,0})
const H vec[4,u32] = mul_hi(V, splat(0xffffffff))
fn main() i32 {
  v vec[4,u32] = {1,2,3,4}
  l vec[4,u32] = rotl(v, 1)
  r vec[4,u32] = rotr(v, 1)
  s vec[4,u32] = shuffle(v, splat(0), {7,4,1,0})
  h vec[4,u32] = mul_hi(v, {0xffffffff,0xffffffff,0xffffffff,0xffffffff})
  data arr[4,u32] = {}
  p addr = &data
  volatile_store[vec[4,u32]](p, {1,2,3,4})
  m vec[4,bool] = {true,false,true,false}
  masked_store[u32](p, m, splat(9))
  loaded vec[4,u32] = volatile_load[vec[4,u32]](p)
  i u32 = 0
  while i < 4 {
    if l[i] != oracle(i,0) || L[i] != oracle(i,0) { return 1 }
    if r[i] != oracle(i,1) || R[i] != oracle(i,1) { return 2 }
    if s[i] != oracle(i,2) || S[i] != oracle(i,2) { return 3 }
    if loaded[i] != oracle(i,3) { return 4 }
    if h[i] != oracle(i,4) || H[i] != oracle(i,4) { return 5 }
    i += 1
  }
  return 0
}
