fn main() i32 {
  narrow u8 = 33
  equal u32 = 33
  wide u64 = 33
  one vec[4,u32] = splat(1)
  high vec[4,u32] = splat(0x80000000)
  negative vec[4,i32] = splat(-2)
  two vec[4,u32] = splat(2)

  shl_narrow vec[4,u32] = shl(one, narrow)
  shl_equal vec[4,u32] = shl(one, equal)
  shl_wide vec[4,u32] = shl(one, wide)
  lshr_narrow vec[4,u32] = lshr(high, narrow)
  lshr_equal vec[4,u32] = lshr(high, equal)
  lshr_wide vec[4,u32] = lshr(high, wide)
  ashr_narrow vec[4,i32] = ashr(negative, narrow)
  ashr_equal vec[4,i32] = ashr(negative, equal)
  ashr_wide vec[4,i32] = ashr(negative, wide)
  rotl_narrow vec[4,u32] = rotl(one, narrow)
  rotl_equal vec[4,u32] = rotl(one, equal)
  rotl_wide vec[4,u32] = rotl(one, wide)
  rotr_narrow vec[4,u32] = rotr(two, narrow)
  rotr_equal vec[4,u32] = rotr(two, equal)
  rotr_wide vec[4,u32] = rotr(two, wide)

  if shl_narrow[0] != 2 { return 1 }
  if shl_equal[1] != 2 { return 2 }
  if shl_wide[2] != 2 { return 3 }
  if lshr_narrow[0] != 0x40000000 { return 4 }
  if lshr_equal[1] != 0x40000000 { return 5 }
  if lshr_wide[2] != 0x40000000 { return 6 }
  if ashr_narrow[0] != -1 { return 7 }
  if ashr_equal[1] != -1 { return 8 }
  if ashr_wide[2] != -1 { return 9 }
  if rotl_narrow[0] != 2 { return 10 }
  if rotl_equal[1] != 2 { return 11 }
  if rotl_wide[2] != 2 { return 12 }
  if rotr_narrow[0] != 1 { return 13 }
  if rotr_equal[1] != 1 { return 14 }
  if rotr_wide[2] != 1 { return 15 }
  return 0
}
