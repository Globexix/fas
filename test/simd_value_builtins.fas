use "C" <<C
#include <stdint.h>
static int fas_input(int id) {
  static const int values[] = {250, 10, 3, 10, 200, 4, 13, 2, 12, 3, 13, 19, 255, 1, 1, 0};
  return values[id];
}
static int64_t fas_expect_mulhi_i64(int64_t a, int64_t b) {
  return (int64_t)(((__int128)a * (__int128)b) >> 64);
}
static int fas_expect(int op, int n, int a, int b, int c) {
  unsigned x = (unsigned)a & 255u;
  unsigned y = (unsigned)b & 255u;
  unsigned z = (unsigned)c;
  unsigned count;
  unsigned value;
  switch (op) {
  case 0: return x + y > 255u ? 255 : (int)(x + y);
  case 1: return x < y ? 0 : (int)(x - y);
  case 2: return (int)((x * y) >> 8);
  case 3:
    count = y & 7u;
    return (int)(((x << count) | (x >> ((8u - count) & 7u))) & 255u);
  case 4:
    count = y & 7u;
    return (int)(((x >> count) | (x << ((8u - count) & 7u))) & 255u);
  case 5:
    value = 0;
    for (count = x; count != 0; count >>= 1) value += count & 1u;
    return (int)value;
  case 6:
    if (x == 0) return 8;
    value = 0;
    for (count = 128; (x & count) == 0; count >>= 1) ++value;
    return (int)value;
  case 7:
    if (x == 0) return 8;
    value = 0;
    while ((x & 1u) == 0) { ++value; x >>= 1; }
    return (int)value;
  case 8: return (x * (unsigned)n) & 255u;
  case 9: return (int)x;
  case 10: return (int)x;
  case 11: return (int)x;
  case 12: return (int)x;
  case 13: return (n & 1) ? (int)x : 0;
  case 14: return y < (unsigned)n ? (int)x : 0;
  case 15: return z < (unsigned)n ? (int)x : (z < (unsigned)(2 * n) ? (int)y : 0);
  case 16: return b != 0 ? (int)x : 0;
  case 17: return b != 0 ? (int)x : 0;
  case 18: return b != 0 ? (int)x : (int)z;
  case 19: return b != 0;
  case 20: return b != 0;
  default: return -1;
  }
}
