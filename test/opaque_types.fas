fn preserve(value handle[First]) handle[First] {
  local handle[First] = value
  return local
}

fn make_addr(value handle[First]) addr {
  return handle_addr(value)
}

fn recover(value addr) handle[First] {
  return handle_from_addr[First](value)
}

fn pointer_layout() usize {
  return sizeof[addr] + alignof[addr]
}

fn main() i32 {
  base addr = addr_from_bits(0)
  first handle[First] = handle_from_addr[First](base)
  same handle[First] = preserve(first)
  back addr = make_addr(same)
  if addr_bits(back) != 0 { return 1 }
  round_trip handle[First] = recover(back)
  if addr_bits(handle_addr(round_trip)) != 0 { return 2 }
  if pointer_layout() != 16 { return 3 }
  return 0
}

opaque First
