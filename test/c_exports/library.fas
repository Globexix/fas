use "dependency.fas"
use "C" "types.h"
use "C" <<C
#include <stdlib.h>
static int compare_for_qsort(const void *a, const void *b) {
    return fas_compare((void *)a, (void *)b);
}
int sort_values(void *base, size_t count) {
    qsort(base, count, sizeof(int32_t), compare_for_qsort);
    return dependency_value();
}
static void (*event_callback)(int32_t, void *);
static void *event_data;
static void register_event(void (*callback)(int32_t, void *), void *data) {
    event_callback = callback;
    event_data = data;
}
int run_events(void *data) {
    register_event(fas_event, data);
    for (int i = 1; i <= 4; ++i) event_callback(i, event_data);
    return fas_read();
}
C
opaque NativeToken
struct Nested { x i16, flag bool }
struct State @align(32) {
    nested Nested
    vector vec[3,u8]
    mask vec[8,bool]
    pointer addr
    token handle[NativeToken]
    data arr[2,arr[3,i32]]
}
extern "C" {
var scalar i32 = 7
var table arr[4,i32] = {4,-2,9,1}
var state State = {{3,true},splat(2),splat(true),null,null,{{1,2,3},{4,5,6}}}
var table_address addr = &table
var nested_address addr = &state.nested
var text addr = c"fas"
var tagged handle[ExportTag] = null
var alias handle[ExportAlias] = null
fn fas_compare(a addr, b addr) i32 {
    x i32 = a[i32,0]
    y i32 = b[i32,0]
    if x < y { return -1 }
    if x > y { return 1 }
    return 0
}
fn fas_event(value i32, data addr) void {
    data[i32,0] += value * scalar
}
fn fas_read() i32 {
    return scalar + table[0] + state.data[1][2] + zext[i32](state.vector[2])
}
fn fas_inline(x i32) i32 { return export_inline(x) }
fn fas_tag(x handle[ExportTag]) handle[ExportTag] { return x }
fn fas_alias(x handle[ExportAlias]) handle[ExportAlias] { return x }
fn fas_bool(x bool) bool { return !x }
}
