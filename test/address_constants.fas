use "C" <<C
extern int Imported;
extern char names[4][8];
extern int inspect_tables(void *, void *, void *);
C
struct Record { head i32
body arr[3,i32] }
struct Entry { name addr
child addr
parent addr }
const Sprnames arr[3,addr] = {c"TROO", c"SARG", c"PLAY"}
const Menu arr[2,Entry] = {{c"root", &Menu[1], &Menu}, {c"leaf", null, &Menu[0]}}
const Slots arr[4,addr] = {&Target, &Target.head, &Target.body[1+0], &Imported}
var Target Record = {5, {7,11,13}}
var A addr = &B
var B addr = &A
extern "C" {
fn fas_run() i32 {
if Sprnames[0][u8] != 'T' { return 1 }
if Sprnames[2][u8,3] != 'Y' { return 2 }
if Menu[0].child != &Menu[1] { return 3 }
if Menu[1].parent != &Menu[0] { return 4 }
if A != &B || B != &A { return 5 }
if inspect_tables(&Slots, &Menu, &Sprnames) != 0 { return 6 }
if Target.head != 101 || Target.body[0] != 103 || Target.body[1] != 107 { return 7 }
if Imported != 109 { return 8 }
if names[2][3] != 'Z' { return 9 }
names[1][4] = 'Q'
if Slots[2][i32] != 107 { return 10 }
return 0
}
}
