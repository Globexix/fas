extern "C" {
  fn observe(value i32) i32
}

fn helper() void {
  defer { observe(100) }
  observe(10)
}

fn main(argc i32, argv ptr[u8]) i32 {
  if argc == 2 {
    switch observe(1) {
      case 1: observe(11)
      case 2: observe(22)
    }
    observe(9)
    return 0
  }
  if argc == 3 {
    switch observe(3) {
      case 1: observe(11)
    }
    observe(9)
    return 0
  }
  if argc == 4 {
    for i i32 = 0; observe(70) == 70 && i < 3; i += observe(1) {
      defer { observe(100 + i) }
      observe(10 + i)
      if i == 0 { continue }
      observe(20 + i)
    }
    observe(9)
    return 0
  }
  if argc == 5 {
    i i32 = 0
    while observe(70) == 70 && i < 3 {
      defer { observe(100) }
      observe(10)
      i += 1
      if i < 3 { continue }
    }
    observe(9)
    return 0
  }
  if argc == 6 {
    for i i32 = 0; i < 5; i += observe(50) {
      defer { observe(100) }
      observe(10)
      break
    }
    observe(9)
    return 0
  }
  if argc == 7 {
    flag bool = argc > 100
    if flag {
      defer { observe(1) }
    }
    observe(2)
    return 0
  }
  if argc == 8 {
    defer { observe(1) }
    observe(2)
    q i32 = 8 / observe(0)
    return 0
  }
  if argc == 9 {
    defer { observe(1) }
    defer { q i32 = 8 / observe(0) }
    observe(2)
    return 0
  }
  if argc == 10 {
    helper()
    observe(9)
    return 0
  }
  return 0
}
