fn append(out ptr[u64], digit u64) void {
  out.* = out.* * 10 + digit
}

fn fallthrough(out ptr[u64]) void {
  defer { append(out, 1) }
  defer { append(out, 2) }
}

fn return_order(out ptr[u64]) i32 {
  defer { append(out, 3) }
  defer { append(out, 4) }
  return 17
}

fn nested_return(out ptr[u64]) i32 {
  defer { append(out, 5) }
  {
    defer { append(out, 6) }
    return 18
  }
}

fn break_unwind(out ptr[u64]) void {
  while true {
    defer { append(out, 7) }
    break
  }
}

fn continue_unwind(out ptr[u64]) void {
  index u64 = 0
  while index < 2 {
    defer { append(out, 8) }
    index += 1
    continue
  }
}

fn conditional_unwind(out ptr[u64], select bool) void {
  if select {
    defer { append(out, 9) }
  } else {
    defer { append(out, 1) }
  }
}

fn switch_unwind(out ptr[u64], select u64) void {
  switch select {
    case 1: { defer { append(out, 2) } }
    default: { defer { append(out, 3) } }
  }
}

fn after_guard(out ptr[u64], stop bool) void {
  if stop { return }
  defer { append(out, 4) }
}

fn preserve_return(out ptr[u64]) u64 {
  value u64 = 5
  defer {
    append(out, 6)
    value = 9
  }
  return value
}

fn main() i32 {
  trace u64 = 0
  fallthrough(&trace)
  if trace != 21 { return 1 }

  trace = 0
  result i32 = return_order(&trace)
  if result != 17 { return 2 }
  if trace != 43 { return 3 }

  trace = 0
  result = nested_return(&trace)
  if result != 18 { return 4 }
  if trace != 65 { return 5 }

  trace = 0
  break_unwind(&trace)
  if trace != 7 { return 6 }

  trace = 0
  continue_unwind(&trace)
  if trace != 88 { return 7 }

  trace = 0
  conditional_unwind(&trace, true)
  conditional_unwind(&trace, false)
  if trace != 91 { return 8 }

  trace = 0
  switch_unwind(&trace, 1)
  switch_unwind(&trace, 0)
  if trace != 23 { return 9 }

  trace = 0
  after_guard(&trace, true)
  if trace != 0 { return 10 }
  after_guard(&trace, false)
  if trace != 4 { return 11 }

  trace = 0
  preserved u64 = preserve_return(&trace)
  if preserved != 5 { return 12 }
  if trace != 6 { return 13 }

  return 0
}
