fn main() i64 {
  a vec[4, u32] = splat(6)
  b vec[4, u32] = splat(2)
  s vec[4, u32] = a << b
  m vec[4, bool] = s == splat(24)
  n vec[4, bool] = !m
  q vec[4, u32] = a / b
  z vec[4, u64] = zext[vec[4,u64]](b)
  c vec[4, i32] = splat(-6)
  d vec[4, i32] = splat(2)
  e vec[4, i32] = c / d
  if n[0] { return 1 }
  if !m[1] { return 2 }
  if q[2] != 3 { return 3 }
  if z[3] != 2 { return 4 }
  if s[0] != 24 { return 5 }
  if e[0] != -3 { return 6 }
  return 0
}
