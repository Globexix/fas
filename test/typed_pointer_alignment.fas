extern "C" {
  fn c_allocate_aligned(alignment usize, size usize) addr
  fn c_release_aligned(storage addr) void
  fn c_is_aligned(storage addr, alignment usize) bool
  fn c_check_lanes(values addr, count usize, expected u64) bool
}

fn write_lanes(destination addr, value vec[8, u64]) void {
  destination[vec[8, u64]] = value
}

fn read_lanes(source addr) vec[8, u64] {
  return source[vec[8, u64]]
}

fn main() i32 {
  alignment usize = alignof[vec[8, u64]]
  size usize = sizeof[vec[8, u64]]
  if alignment != 64 || size != 64 {
    return 1
  }

  storage addr = c_allocate_aligned(alignment, size)
  if addr_bits(storage) == 0 {
    return 2
  }
  if !c_is_aligned(storage, alignment) {
    c_release_aligned(storage)
    return 3
  }

  values addr = storage
  write_lanes(values, splat(41))
  loaded vec[8, u64] = read_lanes(values)
  if loaded[0] != 41 || loaded[7] != 41 {
    c_release_aligned(storage)
    return 4
  }
  if !c_check_lanes(values, 8, 41) {
    c_release_aligned(storage)
    return 5
  }

  c_release_aligned(storage)
  return 0
}
