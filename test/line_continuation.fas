extern "C" {
  fn cont_add(a i32, b i32) i32 {
    return a + b
  }

  fn cont_sum(a i32, b i32, c i32) i32 {
    return a +
      b +
      c
  }

  fn cont_arith(a i32, b i32) i32 {
    x i32 = a *
      b
    y i32 = x /
      2 %
      5
    z i32 = y &
      15 |
      32 ^
      3
    return z <<
      1 >>
      1
  }

  fn cont_compare(a i32, b i32) i32 {
    if a <
      b &&
      a !=
      0 ||
      a >=
      b {
      return 1
    }
    return 0
  }

  fn cont_if(a i32, b i32) i32 {
    if a > 0 &&
        b > 0 ||
        a == b {
      return 1
    }
    return 0
  }

  fn cont_while(n i32) i32 {
    i i32 = 0
    total i32 = 0
    while i <
        n {
      total = total +
        i
      i += 1
    }
    return total
  }

  fn cont_for(n i32) i32 {
    total i32 = 0
    for i i32 = 0; i <
        n &&
        total >=
        0; i += 1 {
      total += i
    }
    return total
  }

  fn cont_call(a i32, b i32) i32 {
    return cont_add(a +
      b, 1)
  }

  fn cont_init(a i32) i32 {
    x i32 = a -
      1
    return x
  }

  fn cont_blank(a i32, b i32) i32 {
    return a *

      // a comment between the operator and its operand
      b
  }

  fn cont_block_comment(a i32, b i32) i32 {
    return a + /* a block comment */
      b
  }
}
