use "C" <<C
static unsigned oracle(unsigned x) { return x + 4u; }
C
struct Ring[N const usize] { head u32
items arr[N,u32] }
fn read[N const usize](p addr) u32 { return p[Ring[N]].head }
fn main() i32 {
  r Ring[4] = {37, {1, 2, 3, 4}}
  p addr = &r
  view v = p[Ring[4], 0]
  v.head = 41
  if read[4](p) != oracle(37) { return 1 }
  if p[Ring[4]].items[3] != 4 { return 2 }
  a arr[4,u32] = {5, 6, 7, 8}
  q addr = &a
  if q[arr[4,u32]][2] != 7 { return 3 }
  indices arr[1,u32] = {2}
  if a[indices[0]] != 7 || a[indices[0] + 1] != 8 { return 4 }
  { Ring arr[1,u32] = {1}
    if a[Ring[0]] != 6 { return 5 } }
  if p[Ring[4]].head != 41 { return 6 }
  return 0
}
