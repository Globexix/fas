use "C" <<C
struct FasNestedPayload {
  unsigned char prefix;
  unsigned int value;
};
union FasNestedEvent {
  struct FasNestedPayload payload;
  unsigned char bytes[16];
};
struct FasNestedHolder {
  unsigned long long stamp;
  union FasNestedEvent event;
};
struct FasNestedHolder fas_nested_holder = {0, {{{1, 739}}}};
unsigned int fas_nested_expected(void) { return fas_nested_holder.event.payload.value; }
C

fn main() i32 {
  if fas_nested_holder.event.payload.value != fas_nested_expected() { return 1 }
  return 0
}
