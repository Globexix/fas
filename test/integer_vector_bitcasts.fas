fn same_shape(values vec[4,i32]) vec[4,u32] {
  return bitcast[vec[4,u32]](values)
}

fn reshape(value u64) u64 {
  words vec[2,u32] = bitcast[vec[2,u32]](value)
  bytes vec[8,u8] = bitcast[vec[8,u8]](words)
  return bitcast[u64](bytes)
}

fn pack_flags(flags vec[8,bool]) u8 {
  return bitcast[u8](flags)
}

fn main() i32 {
  signed_values vec[4,i32] = splat(-1)
  unsigned_values vec[4,u32] = bitcast[vec[4,u32]](signed_values)
  if unsigned_values[0] != 4294967295 { return 1 }

  value u64 = 81985529216486895
  if reshape(value) != value { return 2 }

  flags vec[8,bool] = splat(true)
  if pack_flags(flags) != 255 { return 3 }

  return 0
}
