extern "C" {
    fn fas_bool(x bool) bool { return x }
    fn fas_u8(x u8) u8 { return x }
    fn fas_i8(x i8) i8 { return x }
    fn fas_u16(x u16) u16 { return x }
    fn fas_i16(x i16) i16 { return x }
    fn fas_u32(x u32) u32 { return x }
    fn fas_i32(x i32) i32 { return x }
    fn fas_u64(x u64) u64 { return x }
    fn fas_i64(x i64) i64 { return x }
    fn fas_usize(x usize) usize { return x }
    fn fas_isize(x isize) isize { return x }
    fn fas_read(value addr) u8 { return value[u8] }
    fn fas_write(value addr, replacement u8) void { value[u8] = replacement }
    fn fas_const_ptr(value addr) addr { return value }
    fn fas_mut_ptr(value addr) addr { return value }
    fn fas_noop() void { }
}
