struct Pair {
    left i64
    right i64
}

struct Big {
    a i64
    b i64
    c i64
}

struct Aligned @align(16) {
    tag u8
    value u64
}

struct Nested {
    lead u8
    item Aligned
    tail u8
}

struct Empty @align(32) {}

const VALUES arr[3,i64] = {4, 5, 6}

fn check_pair(p addr) bool { return p[Pair].left == 11 && p[Pair].right == -7 }
fn check_big(p addr) bool { return p[Big].a == 1 && p[Big].b == 2 && p[Big].c == 3 }
fn check_aligned(p addr) bool { return p[Aligned].tag == 9 && p[Aligned].value == 77 }
fn check_nested(p addr) bool {
    return p[Nested].lead == 5 && p[Nested].item.value == 77 && p[Nested].tail == 6
}
fn accept_empty(p addr) void { return }
fn check_array(p addr) bool { return p[i64,0] == 4 && p[i64,1] == 5 && p[i64,2] == 6 }
fn pass_vector(x vec[3,i32]) vec[3,i32] { return x }

fn main() i32 {
    pair_source Pair = {11, -7}
    if !check_pair(&pair_source) { return 1 }
    big_source Big = {1, 2, 3}
    if !check_big(&big_source) { return 2 }
    aligned_source Aligned = {9, 77}
    if !check_aligned(&aligned_source) { return 3 }
    nested_source Nested = {5, {9, 77}, 6}
    if !check_nested(&nested_source) { return 4 }
    empty_source Empty = {}
    accept_empty(&empty_source)
    array arr[3,i64]
    copy(array, VALUES)
    if !check_array(&array) { return 5 }
    vector vec[3,i32] = splat(0)
    vector[0] = 8
    vector[1] = 9
    vector[2] = 10
    vector = pass_vector(vector)
    if vector[0] != 8 || vector[1] != 9 || vector[2] != 10 { return 6 }
    raw_string addr = "a\0b"
    if raw_string[u8] != 97 || raw_string[u8, 1] != 0 || raw_string[u8, 2] != 98 { return 7 }
    terminated addr = c"x"
    if terminated[u8] != 120 || terminated[u8, 1] != 0 { return 8 }
    empty_literal addr = ""
    empty_c_literal addr = c""
    if empty_c_literal[u8] != 0 { return 9 }
    return 0
}
