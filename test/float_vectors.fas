use "C" <<C
#include <stdint.h>
uint32_t float_vectors_expect32(uint32_t op, uint32_t a, uint32_t b, uint32_t c);
uint64_t float_vectors_expect64(uint32_t op, uint64_t a, uint64_t b, uint64_t c);
uint32_t float_vectors_narrow64(uint64_t a);
C

const FV32 vec[4,f32] = {1.0, -2.0, 3.5, -4.25}
const FC32 vec[4,f32] = sqrt(FV32)
const FV_PACKED vec[2,u64] = bitcast[vec[2,u64]](FV32)
const FV_RESTORED vec[4,f32] = bitcast[vec[4,f32]](FV_PACKED)
var FG32 vec[4,f32] = {1.0, 2.0, 3.0, 4.0}

fn check32[N const usize](ap addr, bp addr, cp addr, ip addr, pp addr) i32 {
  ab vec[N,u32] = ap[vec[N,u32]]
  bb vec[N,u32] = bp[vec[N,u32]]
  cb vec[N,u32] = cp[vec[N,u32]]
  ai vec[N,i32] = ip[vec[N,i32]]
  pi vec[N,u32] = pp[vec[N,u32]]
  a vec[N,f32] = bitcast[vec[N,f32]](ab)
  b vec[N,f32] = bitcast[vec[N,f32]](bb)
  c vec[N,f32] = bitcast[vec[N,f32]](cb)
  add vec[N,f32] = a + b
  sub vec[N,f32] = a - b
  mul vec[N,f32] = a * b
  div vec[N,f32] = a / b
  neg vec[N,f32] = -a
  root vec[N,f32] = sqrt(a)
  down vec[N,f32] = floor(a)
  up vec[N,f32] = ceil(a)
  near vec[N,f32] = round(a)
  mag vec[N,f32] = abs(a)
  fused vec[N,f32] = fma(a, b, c)
  eq vec[N,bool] = a == b
  ne vec[N,bool] = a != b
  lt vec[N,bool] = a < b
  le vec[N,bool] = a <= b
  gt vec[N,bool] = a > b
  ge vec[N,bool] = a >= b
  choose vec[N,f32] = select(lt, b, c)
  broadcast vec[N,f32] = splat(a[0])
  converted vec[N,f32] = cvt[vec[N,f32]](ai)
  saturated vec[N,i32] = cvt[vec[N,i32]](a)
  widened vec[N,f64] = cvt[vec[N,f64]](a)
  narrowed vec[N,f32] = cvt[vec[N,f32]](widened)
  bits vec[N,u32] = bitcast[vec[N,u32]](a)
  repacked vec[N / 2,u64] = bitcast[vec[N / 2,u64]](a)
  restored vec[N,f32] = bitcast[vec[N,f32]](repacked)
  compound vec[N,f32] = a
  compound += b
  permuted vec[N,f32] = permute(a, pi)
  mask vec[N,bool] = lt
  movement_mask vec[N,bool] = splat(true)
  compacted vec[N,f32] = compress(a, movement_mask)
  expanded vec[N,f32] = expand(a, movement_mask)
  j usize = 0
  while j < N {
    if bitcast[u32](add[j]) != float_vectors_expect32(0, ab[j], bb[j], cb[j]) { return 1 }
    if bitcast[u32](sub[j]) != float_vectors_expect32(1, ab[j], bb[j], cb[j]) { return 2 }
    if bitcast[u32](mul[j]) != float_vectors_expect32(2, ab[j], bb[j], cb[j]) { return 3 }
    if bitcast[u32](div[j]) != float_vectors_expect32(3, ab[j], bb[j], cb[j]) { return 4 }
    if bitcast[u32](neg[j]) != float_vectors_expect32(4, ab[j], bb[j], cb[j]) { return 5 }
    if bitcast[u32](root[j]) != float_vectors_expect32(5, ab[j], bb[j], cb[j]) { return 6 }
    if bitcast[u32](down[j]) != float_vectors_expect32(6, ab[j], bb[j], cb[j]) { return 7 }
    if bitcast[u32](up[j]) != float_vectors_expect32(7, ab[j], bb[j], cb[j]) { return 8 }
    if bitcast[u32](near[j]) != float_vectors_expect32(8, ab[j], bb[j], cb[j]) { return 9 }
    if bitcast[u32](mag[j]) != float_vectors_expect32(9, ab[j], bb[j], cb[j]) { return 10 }
    if bitcast[u32](fused[j]) != float_vectors_expect32(10, ab[j], bb[j], cb[j]) { return 11 }
    if eq[j] != (float_vectors_expect32(11, ab[j], bb[j], cb[j]) != 0) { return 12 }
    if ne[j] != (float_vectors_expect32(12, ab[j], bb[j], cb[j]) != 0) { return 13 }
    if lt[j] != (float_vectors_expect32(13, ab[j], bb[j], cb[j]) != 0) { return 14 }
    if le[j] != (float_vectors_expect32(14, ab[j], bb[j], cb[j]) != 0) { return 15 }
    if gt[j] != (float_vectors_expect32(15, ab[j], bb[j], cb[j]) != 0) { return 16 }
    if ge[j] != (float_vectors_expect32(16, ab[j], bb[j], cb[j]) != 0) { return 17 }
    if bitcast[u32](choose[j]) != float_vectors_expect32(17, ab[j], bb[j], cb[j]) { return 18 }
    if bitcast[u32](broadcast[j]) != ab[0] { return 19 }
    if bitcast[u32](converted[j]) != float_vectors_expect32(18, bitcast[u32](ai[j]), 0, 0) { return 20 }
    if bitcast[u32](saturated[j]) != float_vectors_expect32(19, ab[j], 0, 0) { return 21 }
    if bitcast[u64](widened[j]) != float_vectors_expect64(20, ab[j], 0, 0) { return 22 }
    if bitcast[u32](narrowed[j]) != float_vectors_narrow64(bitcast[u64](widened[j])) { return 23 }
    if bits[j] != ab[j] { return 24 }
    if bitcast[u32](restored[j]) != ab[j] { return 25 }
    if bitcast[u32](compound[j]) != float_vectors_expect32(0, ab[j], bb[j], cb[j]) { return 26 }
    if bitcast[u32](permuted[j]) != bitcast[u32](a[pi[j]]) { return 27 }
    if bitcast[u32](compacted[j]) != ab[j] { return 28 }
    if bitcast[u32](expanded[j]) != ab[j] { return 29 }
    j += 1
  }
  return 0
}

fn check64[N const usize](ap addr, bp addr, cp addr, ip addr, pp addr) i32 {
  ab vec[N,u64] = ap[vec[N,u64]]
  bb vec[N,u64] = bp[vec[N,u64]]
  cb vec[N,u64] = cp[vec[N,u64]]
  ai vec[N,u64] = ip[vec[N,u64]]
  pi vec[N,u32] = pp[vec[N,u32]]
  a vec[N,f64] = bitcast[vec[N,f64]](ab)
  b vec[N,f64] = bitcast[vec[N,f64]](bb)
  c vec[N,f64] = bitcast[vec[N,f64]](cb)
  add vec[N,f64] = a + b
  sub vec[N,f64] = a - b
  mul vec[N,f64] = a * b
  div vec[N,f64] = a / b
  neg vec[N,f64] = -a
  root vec[N,f64] = sqrt(a)
  down vec[N,f64] = floor(a)
  up vec[N,f64] = ceil(a)
  near vec[N,f64] = round(a)
  mag vec[N,f64] = abs(a)
  fused vec[N,f64] = fma(a, b, c)
  eq vec[N,bool] = a == b
  ne vec[N,bool] = a != b
  lt vec[N,bool] = a < b
  le vec[N,bool] = a <= b
  gt vec[N,bool] = a > b
  ge vec[N,bool] = a >= b
  choose vec[N,f64] = select(lt, b, c)
  converted vec[N,f64] = cvt[vec[N,f64]](ai)
  saturated vec[N,u64] = cvt[vec[N,u64]](a)
  narrowed vec[N,f32] = cvt[vec[N,f32]](a)
  widened vec[N,f64] = cvt[vec[N,f64]](narrowed)
  bits vec[N,u64] = bitcast[vec[N,u64]](a)
  repacked vec[N * 2,u32] = bitcast[vec[N * 2,u32]](a)
  restored vec[N,f64] = bitcast[vec[N,f64]](repacked)
  compound vec[N,f64] = a
  compound += b
  j usize = 0
  while j < N {
    if bitcast[u64](add[j]) != float_vectors_expect64(0, ab[j], bb[j], cb[j]) { return 1 }
    if bitcast[u64](sub[j]) != float_vectors_expect64(1, ab[j], bb[j], cb[j]) { return 2 }
    if bitcast[u64](mul[j]) != float_vectors_expect64(2, ab[j], bb[j], cb[j]) { return 3 }
    if bitcast[u64](div[j]) != float_vectors_expect64(3, ab[j], bb[j], cb[j]) { return 4 }
    if bitcast[u64](neg[j]) != float_vectors_expect64(4, ab[j], bb[j], cb[j]) { return 5 }
    if bitcast[u64](root[j]) != float_vectors_expect64(5, ab[j], bb[j], cb[j]) { return 6 }
    if bitcast[u64](down[j]) != float_vectors_expect64(6, ab[j], bb[j], cb[j]) { return 7 }
    if bitcast[u64](up[j]) != float_vectors_expect64(7, ab[j], bb[j], cb[j]) { return 8 }
    if bitcast[u64](near[j]) != float_vectors_expect64(8, ab[j], bb[j], cb[j]) { return 9 }
    if bitcast[u64](mag[j]) != float_vectors_expect64(9, ab[j], bb[j], cb[j]) { return 10 }
    if bitcast[u64](fused[j]) != float_vectors_expect64(10, ab[j], bb[j], cb[j]) { return 11 }
    if eq[j] != (float_vectors_expect64(11, ab[j], bb[j], cb[j]) != 0) { return 12 }
    if ne[j] != (float_vectors_expect64(12, ab[j], bb[j], cb[j]) != 0) { return 13 }
    if lt[j] != (float_vectors_expect64(13, ab[j], bb[j], cb[j]) != 0) { return 14 }
    if le[j] != (float_vectors_expect64(14, ab[j], bb[j], cb[j]) != 0) { return 15 }
    if gt[j] != (float_vectors_expect64(15, ab[j], bb[j], cb[j]) != 0) { return 16 }
    if ge[j] != (float_vectors_expect64(16, ab[j], bb[j], cb[j]) != 0) { return 17 }
    if bitcast[u64](choose[j]) != float_vectors_expect64(17, ab[j], bb[j], cb[j]) { return 18 }
    if bitcast[u64](converted[j]) != float_vectors_expect64(18, ai[j], 0, 0) { return 19 }
    if bitcast[u64](saturated[j]) != float_vectors_expect64(19, ab[j], 0, 0) { return 20 }
    if bitcast[u32](narrowed[j]) != float_vectors_narrow64(ab[j]) { return 21 }
    if bitcast[u64](widened[j]) != float_vectors_expect64(20, bitcast[u32](narrowed[j]), 0, 0) { return 22 }
    if bits[j] != ab[j] { return 23 }
    if bitcast[u64](restored[j]) != ab[j] { return 24 }
    if bitcast[u64](compound[j]) != float_vectors_expect64(0, ab[j], bb[j], cb[j]) { return 25 }
    j += 1
  }
  return 0
}

fn check_memory[N const usize](p addr, out_mask addr, out_scatter addr, out_bytes addr, ip addr) i32 {
  raw vec[N,f32] = p[vec[N,f32]]
  view raw_view = p[vec[N,f32]]
  view_value vec[N,f32] = raw_view
  raw_bits vec[N,u32] = bitcast[vec[N,u32]](raw)
  view_bits vec[N,u32] = bitcast[vec[N,u32]](view_value)
  if !all(raw_bits == view_bits) { return 1 }
  raw_view = raw
  mask vec[N,bool] = splat(true)
  index vec[N,usize] = ip[vec[N,usize]]
  bytes vec[N,usize] = splat(0)
  i usize = 0
  while i < N {
    bytes[i] = i * 4
    i += 1
  }
  fallback vec[N,f32] = splat(-17.0)
  masked vec[N,f32] = masked_load[f32](p, mask, fallback)
  masked_bits vec[N,u32] = bitcast[vec[N,u32]](masked)
  if !all(masked_bits == raw_bits) { return 2 }
  out_mask[vec[N,f32]] = raw
  masked_store[f32](out_mask, mask, masked)
  gathered vec[N,f32] = gather[f32](p, index, mask, fallback)
  gathered_bytes vec[N,f32] = gather_bytes[f32](p, bytes, mask, fallback)
  scatter[f32](out_scatter, index, mask, raw)
  scatter_bytes[f32](out_bytes, bytes, mask, raw)
  permuted vec[N,f32] = permute(raw, index)
  permuted_bits vec[N,u32] = bitcast[vec[N,u32]](permuted)
  gathered_bits vec[N,u32] = bitcast[vec[N,u32]](gathered)
  gathered_bytes_bits vec[N,u32] = bitcast[vec[N,u32]](gathered_bytes)
  if !all(permuted_bits == gathered_bits) { return 3 }
  if !all(gathered_bytes_bits == raw_bits) { return 4 }
  return 0
}

fn check_memory64[N const usize](p addr, out_mask addr, out_scatter addr, out_bytes addr, ip addr) i32 {
  raw vec[N,f64] = p[vec[N,f64]]
  view raw_view = p[vec[N,f64]]
  view_value vec[N,f64] = raw_view
  raw_bits vec[N,u64] = bitcast[vec[N,u64]](raw)
  view_bits vec[N,u64] = bitcast[vec[N,u64]](view_value)
  if !all(raw_bits == view_bits) { return 1 }
  raw_view = raw
  mask vec[N,bool] = splat(true)
  index vec[N,usize] = ip[vec[N,usize]]
  bytes vec[N,usize] = splat(0)
  i usize = 0
  while i < N {
    bytes[i] = i * 8
    i += 1
  }
  fallback vec[N,f64] = splat(-17.0)
  masked vec[N,f64] = masked_load[f64](p, mask, fallback)
  masked_bits vec[N,u64] = bitcast[vec[N,u64]](masked)
  if !all(masked_bits == raw_bits) { return 2 }
  out_mask[vec[N,f64]] = raw
  masked_store[f64](out_mask, mask, masked)
  gathered vec[N,f64] = gather[f64](p, index, mask, fallback)
  gathered_bytes vec[N,f64] = gather_bytes[f64](p, bytes, mask, fallback)
  scatter[f64](out_scatter, index, mask, raw)
  scatter_bytes[f64](out_bytes, bytes, mask, raw)
  permuted vec[N,f64] = permute(raw, index)
  permuted_bits vec[N,u64] = bitcast[vec[N,u64]](permuted)
  gathered_bits vec[N,u64] = bitcast[vec[N,u64]](gathered)
  gathered_bytes_bits vec[N,u64] = bitcast[vec[N,u64]](gathered_bytes)
  if !all(permuted_bits == gathered_bits) { return 3 }
  if !all(gathered_bytes_bits == raw_bits) { return 4 }
  return 0
}

fn check_shuffle(ap addr, bp addr) i32 {
  a vec[4,f32] = ap[vec[4,f32]]
  b vec[4,f32] = bp[vec[4,f32]]
  shuffled vec[4,f32] = shuffle(a, b, {7, 4, 1, 0})
  if bitcast[u32](shuffled[0]) != bitcast[u32](b[3]) { return 1 }
  if bitcast[u32](shuffled[1]) != bitcast[u32](b[0]) { return 2 }
  if bitcast[u32](shuffled[2]) != bitcast[u32](a[1]) { return 3 }
  if bitcast[u32](shuffled[3]) != bitcast[u32](a[0]) { return 4 }
  return 0
}

fn check_construction() i32 {
  local vec[4,f32] = {1.0, -2.0, 3.5, -4.25}
  FG32[2] += 1.0
  if bitcast[u32](FV32[0]) != bitcast[u32](local[0]) { return 1 }
  if !all(bitcast[vec[4,u32]](FV_RESTORED) == bitcast[vec[4,u32]](FV32)) { return 4 }
  const_bits vec[4,u32] = bitcast[vec[4,u32]](FC32)
  runtime_root vec[4,f32] = sqrt(FV32)
  runtime_bits vec[4,u32] = bitcast[vec[4,u32]](runtime_root)
  if !all(const_bits == runtime_bits) { return 2 }
  if bitcast[u32](FG32[2]) != float_vectors_expect32(0, 0x40400000, 0x3f800000, 0) { return 3 }
  return 0
}

extern "C" {
  fn float_vectors_check32_2(ap addr, bp addr, cp addr, ip addr, pp addr) i32 { return check32[2](ap,bp,cp,ip,pp) }
  fn float_vectors_check32_4(ap addr, bp addr, cp addr, ip addr, pp addr) i32 { return check32[4](ap,bp,cp,ip,pp) }
  fn float_vectors_check32_8(ap addr, bp addr, cp addr, ip addr, pp addr) i32 { return check32[8](ap,bp,cp,ip,pp) }
  fn float_vectors_check32_16(ap addr, bp addr, cp addr, ip addr, pp addr) i32 { return check32[16](ap,bp,cp,ip,pp) }
  fn float_vectors_check64_2(ap addr, bp addr, cp addr, ip addr, pp addr) i32 { return check64[2](ap,bp,cp,ip,pp) }
  fn float_vectors_check64_4(ap addr, bp addr, cp addr, ip addr, pp addr) i32 { return check64[4](ap,bp,cp,ip,pp) }
  fn float_vectors_check64_8(ap addr, bp addr, cp addr, ip addr, pp addr) i32 { return check64[8](ap,bp,cp,ip,pp) }
  fn float_vectors_memory32_2(p addr, out_mask addr, out_scatter addr, out_bytes addr, ip addr) i32 { return check_memory[2](p,out_mask,out_scatter,out_bytes,ip) }
  fn float_vectors_memory32_4(p addr, out_mask addr, out_scatter addr, out_bytes addr, ip addr) i32 { return check_memory[4](p,out_mask,out_scatter,out_bytes,ip) }
  fn float_vectors_memory32_8(p addr, out_mask addr, out_scatter addr, out_bytes addr, ip addr) i32 { return check_memory[8](p,out_mask,out_scatter,out_bytes,ip) }
  fn float_vectors_memory32_16(p addr, out_mask addr, out_scatter addr, out_bytes addr, ip addr) i32 { return check_memory[16](p,out_mask,out_scatter,out_bytes,ip) }
  fn float_vectors_memory64_2(p addr, out_mask addr, out_scatter addr, out_bytes addr, ip addr) i32 { return check_memory64[2](p,out_mask,out_scatter,out_bytes,ip) }
  fn float_vectors_memory64_4(p addr, out_mask addr, out_scatter addr, out_bytes addr, ip addr) i32 { return check_memory64[4](p,out_mask,out_scatter,out_bytes,ip) }
  fn float_vectors_memory64_8(p addr, out_mask addr, out_scatter addr, out_bytes addr, ip addr) i32 { return check_memory64[8](p,out_mask,out_scatter,out_bytes,ip) }
  fn float_vectors_shuffle(ap addr, bp addr) i32 { return check_shuffle(ap,bp) }
  fn float_vectors_plain32(ap addr, bp addr, cp addr, out addr) void {
    a vec[4,f32] = ap[vec[4,f32]]
    b vec[4,f32] = bp[vec[4,f32]]
    c vec[4,f32] = cp[vec[4,f32]]
    out[vec[4,f32]] = a * b + c
    return
  }
  fn float_vectors_construction() i32 { return check_construction() }
}
