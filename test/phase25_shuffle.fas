use "C" <<C
static unsigned oracle(unsigned lane) { unsigned a[4] = {10, 20, 30, 40}; unsigned b[4] = {50, 60, 70, 80}; unsigned indices[6] = {3, 2, 1, 0, 4, 7}; unsigned i = indices[lane]; return i < 4 ? a[i] : b[i - 4]; }
C
const A vec[4,u32] = {10, 20, 30, 40}
const B vec[4,u32] = {50, 60, 70, 80}
const R vec[6,u32] = shuffle(A, B, {3, 2, 1, 0, 4, 7})
fn main() i32 {
  a vec[4,u32] = {10, 20, 30, 40}
  b vec[4,u32] = {50, 60, 70, 80}
  r vec[6,u32] = shuffle(a, b, {3, 2, 1, 0, 4, 7})
  i u32 = 0
  while i < 6 {
    if r[i] != oracle(i) || R[i] != oracle(i) { return 1 }
    i += 1
  }
  return 0
}
