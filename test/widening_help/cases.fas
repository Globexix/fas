use "C" <stdio.h>

fn show_i32(v i32) i32 {
    return printf(c"%d\n", v)
}

fn show_u32(v u32) i32 {
    return printf(c"%u\n", v)
}

fn show_i64(v i64) i32 {
    return printf(c"%ld\n", v)
}

fn show_u64(v u64) i32 {
    return printf(c"%lu\n", v)
}

fn c1(s i16, t i16) u32 {
    y u32 = bitcast[u32](sext[i32](s) / t >> 1)
    return y
}

fn c2(s i8, t i8) u64 {
    y u64 = bitcast[u64](sext[i64](s) % t)
    return y
}

fn c3(s i8, t i8) i32 {
    y i32 = -sext[i32](s)
    return y
}

fn c4(s u8, t u8) u64 {
    y u64 = ~zext[u64](s)
    return y
}

fn c5(s u16, t u16) i64 {
    y i64 = zext[i64](s) - t
    return y
}

fn c6(s i16, t i16) i64 {
    y i64 = sext[i64](s) * t
    return y
}

fn c7(s u8, t u8) u32 {
    y u32 = zext[u32](s) + t >> 1
    return y
}

fn c8(s i8, t i8) i64 {
    y i64 = sext[i64](s) + t >> 1
    return y
}

fn c9(s i16, t i16) u32 {
    y u32 = bitcast[u32](~sext[i32](s))
    return y
}

fn c10(s i16, t i16) i32 {
    y i32 = sext[i32](s) % t
    return y
}

fn c11(s i16, t i16) u64 {
    y u64 = bitcast[u64](-(sext[i64](s) + t))
    return y
}

fn c12(s u8, t u8) i64 {
    y i64 = (zext[i64](s) - t) / 3
    return y
}

fn main() i32 {
    if show_u32(c1(-32768, -1)) <= 0 { return 1 }
    if show_u32(c1(32767, -32768)) <= 0 { return 1 }
    if show_u32(c1(-300, 7)) <= 0 { return 1 }
    if show_u32(c1(12345, -3)) <= 0 { return 1 }
    if show_u64(c2(-128, -1)) <= 0 { return 1 }
    if show_u64(c2(-128, 3)) <= 0 { return 1 }
    if show_u64(c2(127, -5)) <= 0 { return 1 }
    if show_u64(c2(-7, 127)) <= 0 { return 1 }
    if show_i32(c3(-128, 1)) <= 0 { return 1 }
    if show_i32(c3(127, -1)) <= 0 { return 1 }
    if show_i32(c3(-1, -1)) <= 0 { return 1 }
    if show_i32(c3(0, 5)) <= 0 { return 1 }
    if show_u64(c4(0, 1)) <= 0 { return 1 }
    if show_u64(c4(255, 1)) <= 0 { return 1 }
    if show_u64(c4(128, 255)) <= 0 { return 1 }
    if show_u64(c4(7, 3)) <= 0 { return 1 }
    if show_i64(c5(0, 65535)) <= 0 { return 1 }
    if show_i64(c5(65535, 1)) <= 0 { return 1 }
    if show_i64(c5(40000, 65535)) <= 0 { return 1 }
    if show_i64(c5(1, 2)) <= 0 { return 1 }
    if show_i64(c6(-32768, -32768)) <= 0 { return 1 }
    if show_i64(c6(32767, 32767)) <= 0 { return 1 }
    if show_i64(c6(-1, -32768)) <= 0 { return 1 }
    if show_i64(c6(-300, 7)) <= 0 { return 1 }
    if show_u32(c7(255, 255)) <= 0 { return 1 }
    if show_u32(c7(255, 1)) <= 0 { return 1 }
    if show_u32(c7(0, 0)) <= 0 { return 1 }
    if show_u32(c7(128, 127)) <= 0 { return 1 }
    if show_i64(c8(-128, -128)) <= 0 { return 1 }
    if show_i64(c8(127, 127)) <= 0 { return 1 }
    if show_i64(c8(-1, -2)) <= 0 { return 1 }
    if show_i64(c8(-5, 3)) <= 0 { return 1 }
    if show_u32(c9(-32768, 0)) <= 0 { return 1 }
    if show_u32(c9(32767, 1)) <= 0 { return 1 }
    if show_u32(c9(-1, 1)) <= 0 { return 1 }
    if show_u32(c9(0, -7)) <= 0 { return 1 }
    if show_i32(c10(-32768, -1)) <= 0 { return 1 }
    if show_i32(c10(32767, -32768)) <= 0 { return 1 }
    if show_i32(c10(-7, 3)) <= 0 { return 1 }
    if show_i32(c10(12345, -7)) <= 0 { return 1 }
    if show_u64(c11(-32768, -32768)) <= 0 { return 1 }
    if show_u64(c11(32767, 32767)) <= 0 { return 1 }
    if show_u64(c11(-1, 1)) <= 0 { return 1 }
    if show_u64(c11(100, -200)) <= 0 { return 1 }
    if show_i64(c12(0, 3)) <= 0 { return 1 }
    if show_i64(c12(255, 255)) <= 0 { return 1 }
    if show_i64(c12(1, 255)) <= 0 { return 1 }
    if show_i64(c12(200, 7)) <= 0 { return 1 }
    return 0
}
