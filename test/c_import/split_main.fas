use "C" <pthread.h>
use "C" <stdlib.h>
use "split_worker.fas"
fn main() i32 {
  first pthread_t
  second pthread_t
  if pthread_create(&first, null, &split_worker, null) != 0 { abort() }
  if pthread_join(first, null) != 0 { abort() }
  if pthread_create(&second, null, &split_worker, null) != 0 { abort() }
  if pthread_join(second, null) != 0 { abort() }
  return split_calls()
}
