use "C" <<C
static float oracle_parameter(void) {
  float values[4] = {2.0f, 3.0f, 4.0f, 5.0f};
  float scale[4] = {1.0f, 2.0f, 3.0f, 4.0f};
  float result[4];
  for (int i = 0; i < 4; ++i) result[i] = values[i] * scale[i];
  return result[3];
}
static float oracle_local(void) {
  float values[4] = {2.0f, 3.0f, 4.0f, 5.0f};
  float scale[4] = {1.0f, 2.0f, 3.0f, 4.0f};
  float result[4];
  for (int i = 0; i < 4; ++i) result[i] = values[i] * scale[i];
  float sum = result[3];
  return sum + result[3];
}
static float oracle_struct_literal(void) {
  float values[4] = {2.0f, 3.0f, 4.0f, 5.0f};
  return values[3] * 4.0f;
}
static unsigned int oracle_assignment_base(void) {
  unsigned int values[4] = {2, 3, 4, 5};
  return values[3];
}
static unsigned int oracle_assignment_increment(void) {
  unsigned int values[4] = {2, 3, 4, 5};
  return values[3] + 1;
}
static unsigned int oracle_assignment_fixed(void) {
  unsigned int values[2] = {7, 8};
  return values[1] + 4;
}
static unsigned int oracle_assignment_array(void) {
  unsigned int values[4] = {2, 3, 4, 5};
  unsigned int local[4] = {0, 3, 0, 0};
  return values[3] + local[1];
}
C

extern "C" {
  fn oracle_parameter() f32
  fn oracle_local() f32
  fn oracle_struct_literal() f32
  fn oracle_assignment_base() u32
  fn oracle_assignment_increment() u32
  fn oracle_assignment_fixed() u32
  fn oracle_assignment_array() u32
}

struct H[N const usize] { v vec[N, f32] }
struct AssignLeaf[N const usize] { v vec[N, u32] }
struct AssignOuter[M const usize] { inner AssignLeaf[M] }
struct AssignSame[N const usize] { v vec[N, u32] }
struct AssignOther[K const usize] { v vec[K, u32] }
struct AssignCompound[K const usize] { v vec[K, u32] }
struct AssignArray[N const usize] { v vec[N, u32], a arr[N, u32] }
struct AssignGeneric[N const usize, T] { v vec[N, T] }

fn assign_nested[N const usize](v vec[N, u32]) u32 {
  o AssignOuter[N]
  o.inner.v = v
  return o.inner.v[3]
}

fn assign_same[N const usize](v vec[N, u32]) u32 {
  o AssignSame[N]
  o.v = v
  return o.v[3]
}

fn assign_other[N const usize](v vec[N, u32]) u32 {
  o AssignOther[N]
  o.v = v
  return o.v[3]
}

fn assign_compound[N const usize](v vec[N, u32]) u32 {
  o AssignCompound[N]
  o.v = v
  o.v += {1, 1, 1, 1}
  return o.v[3]
}

fn assign_fixed[N const usize]() u32 {
  o AssignOther[2]
  o.v = {7, 8}
  return trunc[u32](o.v[1] + N)
}

fn assign_peer[N const usize](v vec[N, u32]) u32 {
  o AssignSame[N]
  o.v = v + {0, 0, 0, 0}
  return o.v[3]
}

fn assign_array[N const usize](v vec[N, u32]) u32 {
  o AssignArray[N]
  o.a[1] = 3
  x u32 = o.a[1]
  o.v = v
  return o.v[3] + x
}

fn assign_generic[N const usize, T](v vec[N, T]) T {
  o AssignGeneric[N, T]
  o.v = v
  return o.v[3]
}

fn assign_vector[N const usize](v vec[N, u32]) u32 {
  o vec[N, u32]
  o = v
  return o[3]
}

fn parameter[N const usize](v vec[N, f32]) f32 {
  return (v * {1.0, 2.0, 3.0, 4.0})[3]
}

fn local[N const usize](v vec[N, f32]) f32 {
  x vec[N, f32] = v
  y f32 = (x * {1.0, 2.0, 3.0, 4.0})[3]
  x *= {1.0, 2.0, 3.0, 4.0}
  return y + x[3]
}

fn fixed(v vec[4, f32]) f32 {
  x vec[4, f32] = v
  y f32 = (x * {1.0, 2.0, 3.0, 4.0})[3]
  x *= {1.0, 2.0, 3.0, 4.0}
  return y + x[3]
}

fn struct_literal[N const usize](v vec[N, f32]) f32 {
  local H[N] = {v}
  local.v *= {1.0, 2.0, 3.0, 4.0}
  return local.v[3]
}

fn main() i32 {
  values vec[4, f32] = {2.0, 3.0, 4.0, 5.0}
  if parameter[4](values) != oracle_parameter() { return 1 }
  if local[4](values) != oracle_local() { return 2 }
  if fixed(values) != oracle_local() { return 3 }
  if struct_literal[4](values) != oracle_struct_literal() { return 4 }
  integers vec[4, u32] = {2, 3, 4, 5}
  if assign_nested[4](integers) != oracle_assignment_base() { return 5 }
  if assign_same[4](integers) != oracle_assignment_base() { return 6 }
  if assign_other[4](integers) != oracle_assignment_base() { return 7 }
  if assign_compound[4](integers) != oracle_assignment_increment() { return 8 }
  if assign_fixed[4]() != oracle_assignment_fixed() { return 9 }
  if assign_peer[4](integers) != oracle_assignment_base() { return 10 }
  if assign_array[4](integers) != oracle_assignment_array() { return 11 }
  if assign_generic[4, i32]({2, 3, 4, 5}) != bitcast[i32](oracle_assignment_base()) { return 12 }
  if assign_vector[4](integers) != oracle_assignment_base() { return 13 }
  return 0
}
