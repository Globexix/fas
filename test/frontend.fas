@inline
fn add[N const usize](x i64, y i64) i64 {
  z i64 = x + y
  if z > 0 {
    defer { z += 1 }
  } else {
    z = 0
  }
  for i u64 = 0; i < 2; i += 1 {
    z += i
  }
  switch z {
    case 0: return 0
    default: return z ? z : 1
  }
}
