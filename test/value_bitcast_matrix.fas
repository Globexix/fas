fn to_mask(value bool) vec[1,bool] {
  return bitcast[vec[1,bool]](value)
}

fn to_bool(mask vec[1,bool]) bool {
  return bitcast[bool](mask)
}

fn pack8(mask vec[8,bool]) u8 {
  return bitcast[u8](mask)
}

fn unpack8(bits u8) vec[8,bool] {
  return bitcast[vec[8,bool]](bits)
}

fn words(value u64) vec[2,u32] {
  return bitcast[vec[2,u32]](value)
}

fn bytes_of_words(value vec[2,u32]) vec[8,u8] {
  return bitcast[vec[8,u8]](value)
}

fn bytes_of_u64(value u64) vec[8,u8] {
  return bitcast[vec[8,u8]](value)
}

fn u64_of_bytes(value vec[8,u8]) u64 {
  return bitcast[u64](value)
}

fn one_word(value vec[1,u64]) u64 {
  return bitcast[u64](value)
}

fn one_lane(value u64) vec[1,u64] {
  return bitcast[vec[1,u64]](value)
}

fn wide_bytes(value vec[4,u32]) vec[16,u8] {
  return bitcast[vec[16,u8]](value)
}

fn wide_words(value vec[16,u8]) vec[4,u32] {
  return bitcast[vec[4,u32]](value)
}

fn odd_bytes(value vec[3,u16]) vec[6,u8] {
  return bitcast[vec[6,u8]](value)
}

fn odd_words(value vec[6,u8]) vec[3,u16] {
  return bitcast[vec[3,u16]](value)
}

fn pair64(lo u64, hi u64) vec[2,u64] {
  v vec[2,u64] = splat(0)
  v[0] = lo
  v[1] = hi
  return v
}

fn pair32(lo u32, hi u32) vec[2,u32] {
  v vec[2,u32] = splat(0)
  v[0] = lo
  v[1] = hi
  return v
}

fn pair_i16(lo i16, hi i16) vec[2,i16] {
  v vec[2,i16] = splat(0)
  v[0] = lo
  v[1] = hi
  return v
}

fn pair_i8(lo i8, hi i8) vec[2,i8] {
  v vec[2,i8] = splat(0)
  v[0] = lo
  v[1] = hi
  return v
}

fn pair_u8(lo u8, hi u8) vec[2,u8] {
  v vec[2,u8] = splat(0)
  v[0] = lo
  v[1] = hi
  return v
}

fn triple16(a u16, b u16, c u16) vec[3,u16] {
  v vec[3,u16] = splat(0)
  v[0] = a
  v[1] = b
  v[2] = c
  return v
}

fn triple_bool(a bool, b bool, c bool) vec[3,bool] {
  v vec[3,bool] = splat(false)
  v[0] = a
  v[1] = b
  v[2] = c
  return v
}

fn quad32(a u32, b u32, c u32, d u32) vec[4,u32] {
  v vec[4,u32] = splat(0)
  v[0] = a
  v[1] = b
  v[2] = c
  v[3] = d
  return v
}

fn quad_u64(a u64, b u64, c u64, d u64) vec[4,u64] {
  v vec[4,u64] = splat(0)
  v[0] = a
  v[1] = b
  v[2] = c
  v[3] = d
  return v
}

fn one_bool(value bool) vec[1,bool] {
  v vec[1,bool] = splat(false)
  v[0] = value
  return v
}

fn mask8() vec[8,bool] {
  v vec[8,bool] = splat(false)
  v[0] = true
  v[2] = true
  v[5] = true
  v[7] = true
  return v
}

fn main() i32 {
  if !to_bool(to_mask(true)) { return 1 }
  if to_bool(to_mask(false)) { return 2 }
  if !to_mask(true)[0] { return 3 }
  if to_mask(false)[0] { return 4 }

  if pack8(mask8()) != 165 { return 5 }
  u vec[8,bool] = unpack8(165)
  if !u[0] { return 6 }
  if u[1] { return 7 }
  if !u[2] { return 8 }
  if u[3] { return 9 }
  if u[4] { return 10 }
  if !u[5] { return 11 }
  if u[6] { return 12 }
  if !u[7] { return 13 }
  if pack8(u) != 165 { return 14 }

  w vec[2,u32] = words(81985529216486895)
  if w[0] != 2309737967 { return 15 }
  if w[1] != 19088743 { return 16 }
  b vec[8,u8] = bytes_of_words(w)
  if b[0] != 239 { return 17 }
  if b[1] != 205 { return 18 }
  if b[2] != 171 { return 19 }
  if b[3] != 137 { return 20 }
  if b[4] != 103 { return 21 }
  if b[5] != 69 { return 22 }
  if b[6] != 35 { return 23 }
  if b[7] != 1 { return 24 }
  if u64_of_bytes(bytes_of_u64(81985529216486895)) != 81985529216486895 { return 25 }

  if one_word(one_lane(7)) != 7 { return 26 }
  if one_lane(7)[0] != 7 { return 27 }

  wb vec[16,u8] = wide_bytes(quad32(4294967295, 1, 305419896, 0))
  if wb[0] != 255 { return 28 }
  if wb[4] != 1 { return 29 }
  if wb[7] != 0 { return 30 }
  if wb[8] != 120 { return 31 }
  if wb[9] != 86 { return 32 }
  if wb[10] != 52 { return 33 }
  if wb[11] != 18 { return 34 }
  if wb[15] != 0 { return 35 }
  ww vec[4,u32] = wide_words(wb)
  if ww[0] != 4294967295 { return 36 }
  if ww[1] != 1 { return 37 }
  if ww[2] != 305419896 { return 38 }
  if ww[3] != 0 { return 39 }

  ob vec[6,u8] = odd_bytes(triple16(65535, 4660, 1))
  if ob[0] != 255 { return 40 }
  if ob[1] != 255 { return 41 }
  if ob[2] != 52 { return 42 }
  if ob[3] != 18 { return 43 }
  if ob[4] != 1 { return 44 }
  if ob[5] != 0 { return 45 }
  ow vec[3,u16] = odd_words(ob)
  if ow[0] != 65535 { return 46 }
  if ow[1] != 4660 { return 47 }
  if ow[2] != 1 { return 48 }

  zb vec[3,u16] = zext[vec[3,u16]](triple_bool(true, false, true))
  if zb[0] != 1 { return 49 }
  if zb[1] != 0 { return 50 }
  if zb[2] != 1 { return 51 }

  zu vec[3,u64] = zext[vec[3,u64]](triple16(255, 128, 0))
  if zu[0] != 255 { return 52 }
  if zu[1] != 128 { return 53 }
  if zu[2] != 0 { return 54 }

  su vec[2,u32] = sext[vec[2,u32]](pair_u8(255, 1))
  if su[0] != 4294967295 { return 55 }
  if su[1] != 1 { return 56 }

  si vec[2,i16] = sext[vec[2,i16]](pair_i8(-1, 5))
  if si[0] != -1 { return 57 }
  if si[1] != 5 { return 58 }

  tr vec[2,u8] = trunc[vec[2,u8]](pair32(511, 256))
  if tr[0] != 255 { return 59 }
  if tr[1] != 0 { return 60 }

  tb vec[3,bool] = trunc[vec[3,bool]](triple16(5, 4, 1))
  if !tb[0] { return 61 }
  if tb[1] { return 62 }
  if !tb[2] { return 63 }

  os vec[1,i64] = sext[vec[1,i64]](one_bool(true))
  if os[0] != -1 { return 64 }
  oz vec[1,u64] = zext[vec[1,u64]](one_bool(true))
  if oz[0] != 1 { return 65 }

  sx u8 = 255
  if zext[u32](sx) != 255 { return 66 }
  if sext[u64](sx) != 18446744073709551615 { return 67 }
  if zext[u64](sx) != 255 { return 68 }
  if !trunc[bool](one_lane(5)[0]) { return 69 }
  if trunc[bool](one_lane(4)[0]) { return 70 }
  nx i32 = -1
  if bitcast[u32](nx) != 4294967295 { return 71 }
  sz usize = 7
  if bitcast[u64](sz) != 7 { return 72 }
  iz isize = -3
  if bitcast[i64](iz) != -3 { return 73 }
  if trunc[u16](one_lane(18446744073709551615)[0]) != 65535 { return 75 }
  uw u16 = 40000
  if zext[usize](uw) != 40000 { return 76 }
  iw i16 = -300
  if sext[isize](iw) != -300 { return 77 }
  ns i8 = -1
  if sext[i64](ns) != -1 { return 78 }
  if zext[u32](one_bool(true)[0]) != 1 { return 79 }
  if sext[i32](one_bool(true)[0]) != -1 { return 80 }

  return 0
}
