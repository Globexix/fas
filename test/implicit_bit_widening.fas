use "C" <<C
extern void dump_i64(long value);
extern void dump_u64(unsigned long value);
C
const U8S arr[4, u8] = {0, 1, 127, 255}
const U16S arr[4, u16] = {0, 1, 40000, 65535}
const U32S arr[4, u32] = {0, 3, 2147483648, 4294967295}
const I16S arr[4, i16] = {0, -1, -32768, 32767}
const I16T arr[4, i16] = {-7, 5, -32768, 32767}
const W32 arr[3, u32] = {0, 77, 4294967295}
fn shr_u16(a u16) i32 { x i32 = a >> 1; return x }
fn and_u8(b u8) i32 { x i32 = b & 0x7f; return x }
fn mask_u16(a u16) u32 { x u32 = (a >> 4) & 0xf; return x }
fn div_u32(a u32) u64 { x u64 = a / 3; return x }
fn rem_u8(c u8) u32 { x u32 = c % 10; return x }
fn shr_i16(s i16) i32 { y i32 = s >> 2; return y }
fn and_i16(s i16, t i16) i32 { y i32 = s & t; return y }
fn eq_masked(b u8, w u32) i32 {
    if (b & 0x7f) == w {
        return 1
    }
    return 0
}
fn or_div_u32(a u16, w u32) u32 { x u32 = (a / 3) | w; return x }
fn or_div_u64(a u16, w u32) u64 { y u64 = (a / 3) | w; return y }
fn shr_div_u64(a u32) u64 { y u64 = (a / 3) >> 1; return y }
extern "C" {
fn fas_run() i32 {
    for i usize = 0; i < len(U16S); i += 1 {
        dump_i64(sext[i64](shr_u16(U16S[i])))
        dump_i64(zext[i64](mask_u16(U16S[i])))
    }
    for i usize = 0; i < len(U8S); i += 1 {
        dump_i64(sext[i64](and_u8(U8S[i])))
        dump_i64(zext[i64](rem_u8(U8S[i])))
    }
    for i usize = 0; i < len(U32S); i += 1 {
        dump_u64(div_u32(U32S[i]))
        dump_u64(shr_div_u64(U32S[i]))
    }
    for i usize = 0; i < len(I16S); i += 1 {
        dump_i64(sext[i64](shr_i16(I16S[i])))
    }
    for i usize = 0; i < len(I16S); i += 1 {
        for j usize = 0; j < len(I16T); j += 1 {
            dump_i64(sext[i64](and_i16(I16S[i], I16T[j])))
        }
    }
    for i usize = 0; i < len(U8S); i += 1 {
        for j usize = 0; j < len(W32); j += 1 {
            dump_i64(sext[i64](eq_masked(U8S[i], W32[j])))
        }
    }
    for i usize = 0; i < len(U16S); i += 1 {
        for j usize = 0; j < len(W32); j += 1 {
            dump_i64(zext[i64](or_div_u32(U16S[i], W32[j])))
            dump_u64(or_div_u64(U16S[i], W32[j]))
        }
    }
    return 0
}
}
