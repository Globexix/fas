fn main() i32 {
  negative vec[4,i32] = splat(-1)
  positive vec[4,i32] = splat(1)

  equal vec[4,bool] = negative == negative
  unequal vec[4,bool] = negative != positive
  less vec[4,bool] = negative < positive
  less_equal vec[4,bool] = negative <= positive
  greater vec[4,bool] = positive > negative
  greater_equal vec[4,bool] = positive >= negative

  if !equal[0] { return 1 }
  if !unequal[1] { return 2 }
  if !less[2] { return 3 }
  if !less_equal[3] { return 4 }
  if !greater[0] { return 5 }
  if !greater_equal[1] { return 6 }

  unsigned_high vec[4,u32] = bitcast[vec[4,u32]](negative)
  unsigned_low vec[4,u32] = splat(1)
  unsigned_less vec[4,bool] = unsigned_high < unsigned_low
  unsigned_greater vec[4,bool] = unsigned_high > unsigned_low

  if unsigned_less[0] { return 7 }
  if !unsigned_greater[0] { return 8 }

  true_values vec[8,bool] = splat(true)
  false_values vec[8,bool] = splat(false)
  bool_equal vec[8,bool] = true_values == true_values
  bool_unequal vec[8,bool] = true_values != false_values

  if !bool_equal[0] { return 9 }
  if !bool_unequal[7] { return 10 }

  return 0
}
