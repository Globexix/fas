use "C" "c_nested_tags.h"
use "C" <<NESTED_IMPL
#include <stdio.h>

void fas_nested_report_sizes(size_t outer, size_t outer_tag, size_t deep,
                             size_t deep_d, size_t word, size_t anon,
                             size_t anon_after, size_t holder, size_t inner,
                             size_t leaf, size_t in_anon, size_t fwd) {
  printf("sizes %zu %zu %zu %zu %zu %zu %zu %zu %zu %zu %zu %zu\n", outer,
         outer_tag, deep, deep_d, word, anon, anon_after, holder, inner, leaf,
         in_anon, fwd);
}

void fas_nested_fill_outer(struct NestedOuter *value) {
  value->pos.x = -5;
  value->pos.y = 300;
  value->tag = 77;
}

void fas_nested_report_outer(const struct NestedOuter *value) {
  printf("outer %d %d %d\n", value->pos.x, (int)value->pos.y, value->tag);
}

void fas_nested_fill_deep(struct NestedDeep *value) {
  value->mid.leaf.a = 9;
  value->mid.leaf.b = 0x01020304u;
  value->mid.c = -7;
  value->d = 200;
}

void fas_nested_report_deep(const struct NestedDeep *value) {
  printf("deep %u %u %d %u\n", (unsigned)value->mid.leaf.a, value->mid.leaf.b,
         (int)value->mid.c, (unsigned)value->d);
}

void fas_nested_report_union(const union NestedUnion *value) {
  printf("union %d %d %d\n", (int)value->pair.a, (int)value->pair.b, value->word);
}

void fas_nested_report_anon(const struct NestedAnon *value) {
  printf("anon %u %u %llu %d\n", value->parts.lo, value->parts.hi,
         (unsigned long long)value->whole, value->after);
}

void fas_nested_fill_holder(struct NestedHolder *value) {
  value->body.v = 5;
  value->id = 8;
}

void fas_nested_report_holder(const struct NestedHolder *value) {
  printf("holder %d %d\n", value->body.v, value->id);
}
NESTED_IMPL

fn main() i32 {
  fas_nested_report_sizes(sizeof[NestedOuter], offsetof[NestedOuter, tag],
    sizeof[NestedDeep], offsetof[NestedDeep, d], sizeof[NestedUnion],
    sizeof[NestedAnon], offsetof[NestedAnon, after], sizeof[NestedHolder],
    sizeof[NestedInner], sizeof[NestedLeaf], sizeof[NestedInAnon],
    sizeof[NestedFwd])
  outer NestedOuter = {}
  fas_nested_fill_outer(&outer)
  fas_nested_report_outer(&outer)
  outer.pos.x = outer.pos.x + 2
  outer.tag = outer.tag + sext[i32](outer.pos.y)
  fas_nested_report_outer(&outer)
  deep NestedDeep = {}
  fas_nested_fill_deep(&deep)
  fas_nested_report_deep(&deep)
  deep.mid.leaf.b = deep.mid.leaf.b + 1
  fas_nested_report_deep(&deep)
  word NestedUnion = {}
  word.word = 0x0005FFFE
  fas_nested_report_union(&word)
  word.pair.b = -1
  fas_nested_report_union(&word)
  anon NestedAnon = {}
  anon.parts.lo = 0x11223344
  anon.parts.hi = 0x55667788
  anon.after = 42
  fas_nested_report_anon(&anon)
  anon.parts.hi = 1
  fas_nested_report_anon(&anon)
  holder NestedHolder = {}
  fas_nested_fill_holder(&holder)
  fas_nested_report_holder(&holder)
  holder.body.v = holder.body.v * 3
  fas_nested_report_holder(&holder)
  return 0
}
