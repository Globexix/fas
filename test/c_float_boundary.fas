use "C" "c_float_boundary.h"
use "C" <<C
#include <stdio.h>
C

struct FasFloatState { narrow f32, wide f64 }

extern "C" {
var fas_float_state FasFloatState = {1.25, 3.5}
fn fas_scale_f32(value f32) f32 { return value * 2.0 }
fn fas_scale_f64(value f64) f64 { return value * 3.0 }
fn fas_mixed(
    i0 i32, i1 i32, i2 i32, i3 i32, i4 i32, i5 i32, i6 i32,
    d0 f64, d1 f64, d2 f64, d3 f64, d4 f64, d5 f64, d6 f64, d7 f64, d8 f64
) f64 {
    result f64 = cvt[f64](i0) + 2.0 * cvt[f64](i1) + 4.0 * cvt[f64](i2) + 8.0 * cvt[f64](i3) + 16.0 * cvt[f64](i4) + 32.0 * cvt[f64](i5) + 64.0 * cvt[f64](i6)
    result += d0 + 2.0 * d1 + 4.0 * d2 + 8.0 * d3 + 16.0 * d4 + 32.0 * d5 + 64.0 * d6 + 128.0 * d7 + 256.0 * d8
    return result
}
fn fas_import_probe() i32 {
    narrow f32 = c_float_echo(1.25)
    wide f64 = c_double_echo(2.5)
    if narrow != 1.75 { return 1 }
    if wide != 5.0 { return 2 }
    c_global_f32 = narrow
    c_global_f64 = wide
    c_float_state.narrow = narrow
    c_float_state.wide = wide
    if c_float_state.narrow != narrow { return 3 }
    if c_float_state.wide != wide { return 4 }
    printf(c"%.17g %a\n", wide, wide)
    mixed f64 = c_mixed(1, 2, 3, 4, 5, 6, 7, 0.5, 1.25, 2.5, 3.75, 4.5, 5.25, 6.125, 7.0625, 8.03125)
    printf(c"%.17g %a\n", mixed, mixed)
    return 0
}
}
