struct First {
  value u64
}

struct Second {
  value u64
}

opaque Handle

fn accept_read_only(value addr) bool {
  return value != addr_from_bits(0)
}

fn return_read_only(value addr) addr {
  return value
}

fn choose_read_only(choice bool, mutable addr, read_only addr) addr {
  return choice ? mutable : read_only
}

fn choose_read_only_reversed(choice bool, mutable addr, read_only addr) addr {
  return choice ? read_only : mutable
}

fn main() i32 {
  value u64 = 41
  mutable addr = &value
  read_only addr = mutable
  read_only = mutable

  if !accept_read_only(mutable) { return 1 }
  if return_read_only(mutable) != mutable { return 2 }
  if read_only != mutable { return 3 }
  if choose_read_only(true, mutable, read_only) != mutable { return 4 }
  if choose_read_only(false, mutable, read_only) != read_only { return 5 }
  if choose_read_only_reversed(true, mutable, read_only) != read_only { return 6 }
  if choose_read_only_reversed(false, mutable, read_only) != mutable { return 7 }

  pointer_bits usize = addr_bits(mutable)
  if addr_from_bits(pointer_bits) != mutable { return 8 }

  signed_pointer_bits isize = bitcast[isize](addr_bits(mutable))
  if addr_from_bits(bitcast[usize](signed_pointer_bits)) != mutable { return 9 }

  fixed_pointer_bits u64 = bitcast[u64](addr_bits(mutable))
  if addr_from_bits(bitcast[usize](fixed_pointer_bits)) != mutable { return 10 }

  fixed_signed_pointer_bits i64 = bitcast[i64](addr_bits(mutable))
  if addr_from_bits(bitcast[usize](fixed_signed_pointer_bits)) != mutable { return 11 }

  read_only_bits usize = addr_bits(read_only)
  restored_read_only addr = addr_from_bits(read_only_bits)
  if restored_read_only != read_only { return 12 }

  bytes addr = addr_from_bits(addr_bits(mutable))
  if bytes != mutable { return 13 }

  first_value First = (First){17}
  first addr = &first_value
  second addr = addr_from_bits(addr_bits(first))
  if second != first { return 14 }

  object addr = addr_from_bits(addr_bits(mutable))
  if object != mutable { return 15 }

  holder addr = mutable
  nested addr = &holder
  outer_read_only addr = nested
  if outer_read_only != nested { return 16 }

  return 0
}
